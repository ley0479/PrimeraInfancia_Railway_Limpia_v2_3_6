{
  "schema_version": 1,
  "allowed": [
    "remove_python_bytecode",
    "remove_stale_runtime_temp",
    "remove_stale_pid_files",
    "rotate_oversized_logs",
    "rollback_failed_database_transaction"
  ],
  "forbidden": [
    "change_business_rules",
    "change_roles_or_permissions",
    "delete_participants",
    "modify_official_formats",
    "close_findings_or_alerts",
    "rewrite_historical_records",
    "auto_apply_database_migrations_in_production"
  ],
  "runtime_roots": [".runtime_windows", "data/logs", "data/tmp", "backend/__pycache__"],
  "max_log_bytes": 20971520,
  "stale_temp_hours": 24
}
