# ============================================================================
# PrimeraInfancia 2.3.6 — variables para una instalación nueva en Railway
# Este archivo es solo una plantilla. No escriba aquí secretos reales.
# ============================================================================

# Entorno y persistencia
APP_ENV=production
APP_VERSION=2.3.6-railway-clean
DATA_DIR=/data
SINGLE_TENANT_MODE=true
ALLOW_EXPERIMENTAL_MULTI_TENANT=false

# Genere dos valores aleatorios, diferentes, de 64 caracteres o más.
SECRET_KEY=REEMPLAZAR_CON_SECRETO_ALEATORIO_1
JWT_SECRET_KEY=REEMPLAZAR_CON_SECRETO_ALEATORIO_2

# Administrador de arranque. Se usa solamente cuando el volumen está vacío.
# Nunca use credenciales predeterminadas ni una contraseña reutilizada.
INITIAL_ADMIN_USERNAME=REEMPLAZAR_CON_USUARIO_NO_PREDECIBLE
INITIAL_ADMIN_EMAIL=administrador@ejemplo.com
INITIAL_ADMIN_PASSWORD=REEMPLAZAR_CON_PASSWORD_FUERTE
INITIAL_ADMIN_NAME=Administrador inicial
INITIAL_ADMIN_FORCE_PASSWORD_CHANGE=true
INITIAL_FOUNDATION_NAME=Entorno de pruebas

# Railway proporciona RAILWAY_PUBLIC_DOMAIN después de generar el dominio.
PUBLIC_APP_URL=https://${{ RAILWAY_PUBLIC_DOMAIN }}
FRONTEND_ORIGIN=https://${{ RAILWAY_PUBLIC_DOMAIN }}
ALLOWED_ORIGINS=
TRUSTED_PROXY_COUNT=1
FORCE_HTTPS=true

# Sesiones, contraseñas y protección contra abuso
SESSION_LIFETIME_MINUTES=720
MIN_PASSWORD_LENGTH=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900
RECOVERY_MAX_ATTEMPTS=5
RECOVERY_WINDOW_SECONDS=3600
RECOVERY_LOCK_SECONDS=3600
PASSWORD_RESET_EXPIRES_MINUTES=30

# Recuperación opcional por API HTTPS de Resend. Railway bloquea SMTP en
# Free, Trial y Hobby; esta integración no usa SMTP.
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=
PASSWORD_RESET_PUBLIC_URL=https://${{ RAILWAY_PUBLIC_DOMAIN }}

# Compatibilidad insegura: debe permanecer desactivada.
ALLOW_LEGACY_QUERY_TOKENS=false
ALLOW_PASSWORD_RESET_TOKEN_RESPONSE=false
ENABLE_LEGACY_TENANT_BACKFILL=false

# Ejecución. Mantener una sola réplica y un solo worker mientras se use SQLite.
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300
SQLITE_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
