{
  "version": "2.4.2-tunel-login-logging-corregido",
  "fecha": "2026-08-04",
  "contiene_base_operativa": false,
  "contiene_archivos_env_privados": false,
  "contiene_credenciales_utilizables": false,
  "contiene_logs_de_ejecucion": false,
  "contiene_datos_personales_reales": false,
  "logging": {
    "ruta_operativa": "data/logs",
