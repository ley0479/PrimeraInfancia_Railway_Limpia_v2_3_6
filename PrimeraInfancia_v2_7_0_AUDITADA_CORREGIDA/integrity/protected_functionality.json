{
  "schema_version": 1,
  "policy": "ZERO_REGRESSIONS",
  "required_environments": ["LOCAL", "RAILWAY"],
  "change_rule": "MINIMAL_INCREMENTAL_PATCH",
  "failure_rule": "REJECT_CHANGE",
  "functionalities": [
    {
      "id": "login", "name": "Autenticación y sesión", "before": "PASS", "protection": "PROTECTED",
      "route": "POST /api/auth/login", "dependencies": ["PostgreSQL", "cookies", "multi-tenant"],
      "contracts": [
        {"file": "backend/modules/seguridad/routes.py", "token": "@app.route('/api/auth/login', methods=['POST'])"},
        {"file": "frontend/js/app.js", "token": "/api/auth/login"}
      ],
      "control_tests": ["backend/tests/test_auth_security_v2_5_1.py", "backend/tests/test_public_route_fallback.py"]
    },
    {
      "id": "panel", "name": "Panel principal y navegación", "before": "PASS", "protection": "PROTECTED",
      "route": "GET /", "dependencies": ["frontend/index.html", "static files", "HTTPS proxy"],
      "contracts": [
        {"file": "backend/app.py", "token": "@app.route('/')"},
        {"file": "frontend/index.html", "token": "id=\"login-form\""}
      ],
      "control_tests": ["backend/tests/test_public_route_fallback.py", "backend/tests/test_tunnel_cloudflare_v2_4_3.py"]
    },
    {
      "id": "postgresql", "name": "Fuente de datos PostgreSQL", "before": "PASS", "protection": "PROTECTED",
      "route": "GET /api/health", "dependencies": ["DATABASE_URL", "SQLAlchemy", "psycopg"],
      "contracts": [
        {"file": "backend/config.py", "token": "REQUIRE_POSTGRESQL_IN_PRODUCTION"},
        {"file": "backend/requirements-production.txt", "token": "psycopg[binary]"}
      ],
      "control_tests": ["backend/tests/test_postgresql_compat_v2_6_0.py", "backend/tests/test_init_schema_postgresql_identity.py"]
    },
    {
      "id": "base_maestra", "name": "Carga y consolidación Base Maestra", "before": "PASS", "protection": "PROTECTED",
      "route": "/api/base-maestra", "dependencies": ["PostgreSQL", "fundacion_id", "beneficiarios"],
      "contracts": [{"file": "backend/modules/base_maestra/routes.py", "token": "Blueprint"}],
      "control_tests": ["backend/tests/test_base_maestra_version_index.py"]
    },
    {
      "id": "filtros_uds", "name": "Filtrado y normalización UDS", "before": "PASS", "protection": "PROTECTED",
      "route": "/api/descargar/<unidad>/<formato>", "dependencies": ["catálogo UDS", "URL decoding", "tenant"],
      "contracts": [{"file": "backend/services/uds_catalog.py", "token": "def normalize_unit"}],
      "control_tests": ["backend/tests/test_operational_release_v2_3_7.py"]
    },
    {
      "id": "ram", "name": "Formato RAM", "before": "PASS", "protection": "PROTECTED",
      "route": "GET /api/descargar/<unidad>/ram", "dependencies": ["Base Maestra", "plantilla oficial", "TenantPath"],
      "contracts": [{"file": "backend/services/ram_v3_service.py", "token": "def generate_ram"}],
      "control_tests": ["backend/tests/test_ram_v3_integration.py", "backend/tests/test_ram_official_template_preservation.py"]
    },
    {
      "id": "ran", "name": "Formato RAN", "before": "PASS", "protection": "PROTECTED",
      "route": "GET /api/descargar/<unidad>/ran", "dependencies": ["Base Maestra", "asistencia A", "plantilla oficial"],
      "contracts": [{"file": "backend/services/ram_historical_service.py", "token": "def generate_ram_historical"}],
      "control_tests": ["backend/tests/test_ram_historical_improvements_v2_7_1.py"]
    },
    {
      "id": "rran", "name": "Formato RRAN", "before": "PASS", "protection": "PROTECTED",
      "route": "GET /api/descargar/<unidad>/rran", "dependencies": ["Base Maestra", "plantilla oficial", "tenant"],
      "contracts": [{"file": "backend/app.py", "token": "'rran'"}],
      "control_tests": ["backend/tests/test_ram_download_period_wiring.py"]
    },
    {
      "id": "bienestarina", "name": "Formato Bienestarina", "before": "PASS", "protection": "PROTECTED",
      "route": "GET /api/bienestarina/descargar", "dependencies": ["Base Maestra", "encabezado dinámico", "plantilla oficial"],
      "contracts": [{"file": "backend/app.py", "token": "/api/bienestarina/descargar"}],
      "control_tests": ["backend/tests/test_operational_release_v2_3_7.py"]
    },
    {
      "id": "rpp", "name": "Formato RPP", "before": "PASS", "protection": "PROTECTED",
      "route": "GET /api/rpp/descargar", "dependencies": ["Base Maestra", "minuta", "grupos etarios", "TenantPath"],
      "contracts": [{"file": "backend/app.py", "token": "/api/rpp/descargar"}],
      "control_tests": ["backend/tests/test_rpp_download_tenantpath_v2_7_1.py"]
    },
    {
      "id": "multi_tenant", "name": "Aislamiento por fundación", "before": "PASS", "protection": "PROTECTED",
      "route": "Todas las rutas operativas", "dependencies": ["fundacion_id", "tenant context", "TenantPath"],
      "contracts": [
        {"file": "backend/modules/seguridad/tenant_context.py", "token": "fundacion_id"},
        {"file": "backend/modules/seguridad/tenant_sql_guard.py", "token": "fundacion_id"}
      ],
      "control_tests": ["backend/tests/test_multitenant_phase3.py", "backend/tests/test_multitenant_release_v2_4_0.py"]
    }
  ]
}
